{
  "name": "zephyrlea-molecule-editor",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "smoke:desktop": "npm run smoke --workspace=apps/desktop",
    "set-version": "python scripts/bump_version.py",
    "dev:backend": "apps/backend/.venv/Scripts/python.exe apps/backend/main.py --port 8765"
  },
  "devDependencies": {
    "electron": "31.7.7"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}